# Copiá este archivo a .env y ajustá los valores.

# Puerto del servidor
PORT=3000

# URL pública del sitio (links de compartir y OG tags). Opcional: si no está, se deduce de cada request.
# En producción conviene fijarla, ej: https://bingo.slatv.live
# SITE_URL=https://bingo.slatv.live

# Token de admin. Se usa en /admin y en el CLI (npm run admin).
# CAMBIALO antes de deployar.
ADMIN_TOKEN=cambiame-por-algo-largo

# Fecha límite para crear cartones (hora Argentina, UTC-3).
# Después de esta fecha nadie puede crear cartones nuevos; los existentes quedan congelados.
DEADLINE=2026-11-05T23:59:59-03:00

# Forzar creación abierta aunque ya haya pasado la fecha (solo para probar en local). 1 = abierto.
# FORCE_OPEN=1

# Dónde se guarda la base de datos (archivo JSON).
DB_PATH=./data/db.json

# Cuántos cartones puede crear una misma IP por hora (anti-spam). Subilo para probar en local.
RATE_LIMIT_MAX=5

# Redis (Upstash) — obligatorio en Vercel, opcional en local.
# En Vercel se cargan solos al agregar Upstash desde Storage / Marketplace (KV_REST_API_URL y KV_REST_API_TOKEN).
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxx
# REDIS_PREFIX=bingo
